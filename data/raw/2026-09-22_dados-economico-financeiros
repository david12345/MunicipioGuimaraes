        // --- menu fixo no topo ao fazer scroll ---
        // Substitui o JS que os sites colocavam à mão. A classe .sticky é aplicada
        // ao contentor de navegação do tema (.navContainer) quando existe, para que
        // a barra inteira (logo + menu) fique fixa — e não só a célula do menu. Caso
        // o tema não use .navContainer, recai no próprio wrapper do widget.
        const stickyTarget = container.closest(".navContainer") || container;
        function syncSticky() {
          if (window.scrollY > 0) {
            stickyTarget.classList.add("sticky");
          } else {
            stickyTarget.classList.remove("sticky");
          }
        }

        syncSticky();
        window.addEventListener("scroll", syncSticky, { passive: true });
      });
