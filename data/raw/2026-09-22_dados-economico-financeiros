    <script>
      document.addEventListener("DOMContentLoaded", () => {
        const container = document.querySelector("#horizontal_menu_58");
        const menuElement = container && container.querySelector("ul");
        const Wm = window.AccessibleMenu && window.AccessibleMenu.WmTopLinkDisclosureMenu;

        if (!container || !menuElement || !Wm) {
          return;
        }

        window.AccessibleMenu.menus = window.AccessibleMenu.menus || {};

        // Botão de menu mobile. A normalização (#3664) corre sempre que existe um
        // botão na DOM — mesmo com o pisco desligado — porque os sites que o
        // colocam à mão no modelo de página também precisam do markup acessível.
        // O id wm-menu-toggle-btn é do componente: quem o usa opta pelo nosso
        // markup, e o conteúdo do botão é REESCRITO (ícone SVG decorativo + label
        // como nome). O botão não é movido: o site afinou onde o quis.
        //
        // A injeção (#3503) continua atrás de "Menu para mobile"
        // (mobile_menu_enabled): só aí é que o componente cria o botão que falta,
        // já com o markup canónico e como irmão anterior ao menu.
        //
        // A label é o rótulo visível E o nome acessível, logo vem do i18n — um
        // literal aqui imporia português a um site noutra língua. `to_json` gera
        // as aspas e escapa o conteúdo para contexto de script.
        let controllerElement = document.querySelector("#wm-menu-toggle-btn");
        if (controllerElement) {
          Wm.normalizeController(controllerElement, { label: "Menu" });
        }
        if (controllerElement === null) {
          controllerElement = Wm.ensureController(container, { label: "Menu" });
        }

        // Padrão disclosure (a11y-PT): Tab nativo, sem setas. Os defaults de disclosure
        // (optionalKeySupport:false, hoverType:'off'), a criação do controlador e o lock
        // de scroll vivem na subclasse WmTopLinkDisclosureMenu.
        //
        // O controllerElement/containerElement só são passados quando existe botão de
        // toggle. Sem botão (pisco desligado e sem botão manual), o menu inicia como
        // disclosure menu simples — evita rebentar a inicialização.
        const menuOptions = {
          menuElement,
          submenuItemSelector: ".dropdown",
          closeClass: "acc-hide",
          openClass: "acc-show"
          // focusInert: true  // ativar/afinar se o teste em VoiceOver Sequoia o exigir
        };

        if (controllerElement) {
          menuOptions.containerElement = container;
          menuOptions.controllerElement = controllerElement;
        }

        new Wm(menuOptions);

        if (controllerElement) {
          Wm.lockBodyScrollOnToggle(controllerElement);
        }

        // --- aria-hidden (report_039 #91) ---
        // Widget único responsivo: em desktop o menu está sempre visível
        // (aria-hidden="false"); em mobile reflete o estado da gaveta — fechada
        // fica aria-hidden="true", aberta fica "false".
        const desktopQuery = window.matchMedia("(min-width: 1024px)");
        let menuOpen = false;

        function syncAriaHidden() {
          const hidden = !desktopQuery.matches && !menuOpen;
          menuElement.setAttribute("aria-hidden", hidden ? "true" : "false");
        }

        syncAriaHidden();
        if (desktopQuery.addEventListener) {
          desktopQuery.addEventListener("change", syncAriaHidden);
        } else if (desktopQuery.addListener) {
          desktopQuery.addListener(syncAriaHidden);
        }

        if (controllerElement) {
          controllerElement.addEventListener("accessibleMenuExpand", function() {
            menuOpen = true;
            syncAriaHidden();
          });

          controllerElement.addEventListener("accessibleMenuCollapse", function() {
            menuOpen = false;
            syncAriaHidden();
          });
