__pycache__/
*.py[cod]
.venv/
venv/
node_modules/
dist/
.DS_Store
.env

# Claude Code: settings.json é partilhado; as locais são pessoais
.claude/settings.local.json

# data/raw/: os originais MUNICIPAIS são commitados (~22 MB). É neles que a
# regra 3 tem valor real — uma autarquia substitui um PDF mantendo o URL, e o
# original commitado é a única prova do que foi extraído.
#
# Os datasets NACIONAIS não (~515 MB): têm arquivo estável e os contratos são
# republicados semanalmente, pelo que cada `make fetch` geraria ficheiros novos.
# Fica commitado o .meta.json de cada um, com URL, sha256, bytes e data — o que
# os reproduz com `make fetch` e mantém a integridade verificável.
data/raw/*contratos[0-9][0-9][0-9][0-9].xlsx
data/raw/*contratos[0-9][0-9][0-9][0-9].zip
data/raw/*_0000200612.pdf
# Resposta da API do INE: 21 MB de dados nacionais, reproduzíveis por `make fetch`.
data/raw/*pindica_*.jsp
# Documentos previsionais (GOP + Orçamento): 83 a 188 MB CADA, 808 MB ao todo,
# e dois deles passam o limite rígido de 100 MB por ficheiro do GitHub. São
# municipais, ao contrário dos de cima, mas a regra 3 não sobrevive a isto: o
# que a torna útil — detetar que a CMG substituiu um PDF mantendo o URL —
# continua garantido pelo sha256 no .meta.json, que é commitado.
data/raw/*grandes_opcoes*.pdf
# Relatórios e Contas: 14 a 21 MB cada, 83 MB ao todo. Acima do limite de ~15 MB
# que esta política fixa, pela mesma razão e com a mesma salvaguarda: o sha256
# no sidecar continua a detetar substituição silenciosa.
data/raw/*relatorio_e_contas*.pdf
data/raw/*relatorio_de_gestao*.pdf

# Downloads interrompidos (ver etl/common/fetch.py).
data/raw/*.parcial
# ... mas os sidecars entram sempre.
!data/raw/*.meta.json
